{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "outDir": "dist",
    "paths": {
      "@syntra/shared": ["../../packages/shared/index.ts"],
      "@syntra/shared/mocks/*.js": ["../../packages/shared/mocks/*.ts"],
      "@syntra/shared/mocks/*": ["../../packages/shared/mocks/*.ts"],
      "@syntra/shared/schemas": ["../../packages/shared/schemas/index.ts"],
      "@syntra/shared/utils": ["../../packages/shared/utils/index.ts"],
      "@syntra/shared/utils/intel-provenance": ["../../packages/shared/utils/intel-provenance.ts"],
      "@syntra/db": ["../../packages/db/index.ts"],
      "@syntra/llm": ["../../packages/llm/index.ts"],
      "@syntra/feeds": ["../../packages/feeds/index.ts"],
      "@syntra/feeds/providers/*": ["../../packages/feeds/providers/*.ts"],
      "@syntra/feeds/withCostGate": ["../../packages/feeds/withCostGate.ts"]
    }
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
