{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@syntra/db": "workspace:*",
    "@syntra/feeds": "workspace:*",
    "@syntra/llm": "workspace:*",
    "@syntra/shared": "workspace:*",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "twilio": "^6.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@sendgrid/mail": "^8.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node"
          }
        }
      ]
    }
  }
}
